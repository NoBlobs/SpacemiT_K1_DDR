diff --git a/board/spacemit/k1/vehicle_reset.c b/board/spacemit/k1/vehicle_reset.c
new file mode 100644
index 0000000..957e622
--- /dev/null
+++ b/board/spacemit/k1/vehicle_reset.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright (C) 2026 Thalles Campagnani
+/*
+ * Validation only (cleanroom doc 32, P-17): once a run is over, hand the
+ * board back to the BootROM so FDL can load the next image without anyone
+ * pressing RST. The host picks the path on the UART:
+ *
+ *   p  PMIC P1 SW_RST: rails drop, as the RST button (default)
+ *   w  SoC watchdog, MMIO only
+ *   h  no reset, the SPL carries on
+ */
+
+#include <asm/io.h>
+#include <dm/uclass.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <power/pmic.h>
+#include <power/spacemit_p1.h>
+#include <stdio.h>
+#include <time.h>
+#include "vehicle_reset.h"
+
+/* "sys" of the BootROM banner; the SPL keeps its boot mode there */
+#define BOOT_FLAG_REG		0xd4282d10
+
+#define MPMU_BASE		0xd4050000UL
+#define MPMU_WDTPCR		(MPMU_BASE + 0x200)
+#define WDTPCR_CLKS		(BIT(0) | BIT(1))
+#define WDTPCR_RST		BIT(2)
+#define MPMU_WDT_START		(MPMU_BASE + 0x1020)
+#define WDT_START		BIT(4)
+
+#define WDT_BASE		0xd4080000UL
+#define WDT_UNLOCK1		0xb0
+#define WDT_UNLOCK2		0xb4
+#define WDT_ENABLE		0xb8
+#define WDT_MATCH		0xbc
+#define WDT_STATUS		0xc0
+#define WDT_RESET_EN		0xc8
+
+#define CHOICE_MS		3000
+#define RESET_WAIT_MS		1000
+
+/* every WDT write needs the unlock pair right before it */
+static void wdt_write(u32 off, u32 val)
+{
+	writel(0xbaba, (void __iomem *)(WDT_BASE + WDT_UNLOCK1));
+	writel(0xeb10, (void __iomem *)(WDT_BASE + WDT_UNLOCK2));
+	writel(val, (void __iomem *)(WDT_BASE + off));
+}
+
+static void reset_wdt(void)
+{
+	/* the SPL's boot mode would otherwise survive into the next BootROM */
+	writel(0, (void __iomem *)BOOT_FLAG_REG);
+	setbits_le32((void __iomem *)MPMU_WDTPCR, WDTPCR_CLKS);
+	clrbits_le32((void __iomem *)MPMU_WDTPCR, WDTPCR_RST);
+	wdt_write(WDT_STATUS, 0);
+	wdt_write(WDT_MATCH, 1);
+	wdt_write(WDT_ENABLE, 3);
+	wdt_write(WDT_RESET_EN, 1);
+	setbits_le32((void __iomem *)MPMU_WDT_START, WDT_START);
+}
+
+static int reset_p1(void)
+{
+	struct udevice *dev;
+	int ret;
+
+	ret = uclass_get_device(UCLASS_PMIC, 0, &dev);
+	if (ret)
+		return ret;
+	/* a reboot, not a charger wake-up */
+	ret = pmic_clrsetbits(dev, P1_REG_ALIVE, 0, BIT(SYS_REBOOT_FLAG_BIT));
+	if (ret)
+		return ret;
+	return pmic_clrsetbits(dev, P1_PWR_CTRL2, 0, P1_SW_RST);
+}
+
+static int read_choice(void)
+{
+	ulong start = get_timer(0);
+
+	while (get_timer(start) < CHOICE_MS) {
+		if (tstc())
+			return getchar();
+	}
+	return 'p';
+}
+
+void k1_vehicle_reset(void)
+{
+	int c, ret;
+
+	printf("K1VEH: sys 0x%08x\n", readl((void __iomem *)BOOT_FLAG_REG));
+	printf("K1VEH: reset? p = PMIC, w = SoC WDT, h = halt\n");
+	c = read_choice();
+	if (c == 'h') {
+		printf("K1VEH: no reset\n");
+		return;
+	}
+	if (c == 'w') {
+		printf("K1VEH: reset by SoC WDT\n");
+		reset_wdt();
+	} else {
+		printf("K1VEH: reset by PMIC P1\n");
+		ret = reset_p1();
+		if (ret) {
+			printf("K1VEH: PMIC write failed (%d), SoC WDT\n", ret);
+			reset_wdt();
+		}
+	}
+	mdelay(RESET_WAIT_MS);
+	printf("K1VEH: still running after the reset request\n");
+}
