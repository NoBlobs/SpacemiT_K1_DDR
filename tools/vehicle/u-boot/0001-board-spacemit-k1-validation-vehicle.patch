diff --git a/board/spacemit/k1/ddr_gpl_test.c b/board/spacemit/k1/ddr_gpl_test.c
new file mode 100644
index 0000000..c97e51b
--- /dev/null
+++ b/board/spacemit/k1/ddr_gpl_test.c
@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright (C) 2026 Thalles Campagnani
+/*
+ * Validation hook for the open K1 DDR firmware. Once ddr_fw.bin has brought
+ * DDR up, the open firmware is copied over it at DDR_FIRMWARE_BASE and its
+ * re-train entry trains the running frequency point again. DRAM is checked
+ * before and after: content kept across the pass, and fresh writes.
+ */
+
+#include <asm/csr.h>
+#include <asm/io.h>
+#include <cpu_func.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <stdio.h>
+#include "ddr_gpl_test.h"
+#ifdef K1_VEHICLE_RESET
+#include "vehicle_reset.h"
+#endif
+
+#define DDR_FIRMWARE_BASE	0xc082d000UL
+#define DDR_CTRL_BASE		0xc0000000UL
+#define PMU_BASE		0xd4282800UL
+#define GPL_RETRAIN_OFFSET	4
+#define GPL_MAGIC_OFFSET	8
+#define GPL_HEADER_SIZE		0x18
+#define PROBE_WORDS		16384
+#define MAX_PROBES		6
+#ifdef K1_DDR_GPL_FULL
+#define RETRAIN_ROUNDS		1
+#else
+#define RETRAIN_ROUNDS		3
+#endif
+#define DRAM_LOW_TOP		0x80000000ULL
+#define DRAM_HIGH_BASE		0x100000000ULL
+
+/* flags: bit 0 logs every Vref step from inside self-refresh */
+typedef int (*ddr_retrain_func_t)(u64 ddr_base, u32 cs_num,
+				  void (*puts_fn)(const char *s), u32 flags);
+
+extern const u8 k1_ddr_gpl_blob[], k1_ddr_gpl_blob_end[];
+
+static u64 cs_size(u32 map)
+{
+	if (!(map & 1))
+		return 0;
+	switch ((map >> 16) & 0x1f) {
+	case 0xd: return 512ULL << 20;
+	case 0x1: return 768ULL << 20;
+	case 0xe: return 1024ULL << 20;
+	case 0x2: return 1536ULL << 20;
+	case 0xf: return 2048ULL << 20;
+	case 0x3: return 3072ULL << 20;
+	case 0x10: return 4096ULL << 20;
+	case 0x11: return 8192ULL << 20;
+	case 0x12: return 16384ULL << 20;
+	default: return 0;
+	}
+}
+
+static int build_probes(u64 *probe)
+{
+	u64 total = cs_size(readl((void __iomem *)(DDR_CTRL_BASE + 0x200))) +
+		    cs_size(readl((void __iomem *)(DDR_CTRL_BASE + 0x208)));
+	u64 low = total < DRAM_LOW_TOP ? total : DRAM_LOW_TOP;
+	u64 high = total - low;
+	int n = 0;
+
+	printf("K1DDRT: %lu MiB mapped\n", (ulong)(total >> 20));
+	if (low) {
+		probe[n++] = 0x10000;
+		probe[n++] = low / 2;
+		probe[n++] = low - 0x10000;
+	}
+	if (high) {
+		probe[n++] = DRAM_HIGH_BASE;
+		probe[n++] = DRAM_HIGH_BASE + high / 2;
+		probe[n++] = DRAM_HIGH_BASE + high - 0x10000;
+	}
+	return n;
+}
+
+static u32 pattern(u64 addr, u32 i, u32 seed)
+{
+	return (u32)(addr >> 4) ^ (i * 0x9e3779b9U) ^ seed ^ (i << 16);
+}
+
+static void fill(u64 base, u32 seed)
+{
+	u32 *p = (u32 *)(uintptr_t)base;
+	u32 i;
+
+	for (i = 0; i < PROBE_WORDS; i++)
+		p[i] = pattern(base, i, seed);
+	flush_dcache_range(base, base + PROBE_WORDS * 4);
+}
+
+static u32 verify(u64 base, u32 seed)
+{
+	const u32 *p = (const u32 *)(uintptr_t)base;
+	u32 i, bad = 0;
+
+	invalidate_dcache_range(base, base + PROBE_WORDS * 4);
+	for (i = 0; i < PROBE_WORDS; i++)
+		if (p[i] != pattern(base, i, seed))
+			bad++;
+	return bad;
+}
+
+static void check_dram(const u64 *probe, int n, u32 old_seed, u32 new_seed)
+{
+	int i;
+
+	for (i = 0; i < n; i++) {
+		u32 kept = old_seed ? verify(probe[i], old_seed) : 0;
+		u32 fresh;
+
+		fill(probe[i], new_seed);
+		fresh = verify(probe[i], new_seed);
+		printf("K1DDRT: dram 0x%lx kept-errors %u fresh-errors %u\n",
+		       (ulong)probe[i], kept, fresh);
+	}
+}
+
+#ifdef K1_VEHICLE_LAT
+/* load-to-use latency: a chase of dependent loads through one cycle of nodes */
+#define CLINT_MTIME		0xe400bff8UL
+#define MTIME_PER_US		24
+#define LAT_BASE		0x10000000UL
+#define LAT_NODE		64
+#define LAT_LOADS		(1U << 20)
+#define LAT_NEXT(i)		(*(u64 *)(uintptr_t)(LAT_BASE + (u64)(i) * LAT_NODE))
+
+static u64 lat_rand(u64 *s)
+{
+	*s ^= *s << 13;
+	*s ^= *s >> 7;
+	*s ^= *s << 17;
+	return *s;
+}
+
+static void lat_build(u32 n, bool random)
+{
+	u64 s = 0x9e3779b97f4a7c15ULL;
+	u32 i;
+
+	for (i = 0; i < n; i++)
+		LAT_NEXT(i) = random ? i : (i + 1) % n;
+	/* Sattolo: a random permutation that is a single cycle */
+	for (i = n - 1; random && i > 0; i--) {
+		u32 j = lat_rand(&s) % i;
+		u64 t = LAT_NEXT(i);
+
+		LAT_NEXT(i) = LAT_NEXT(j);
+		LAT_NEXT(j) = t;
+	}
+	for (i = 0; i < n; i++)
+		LAT_NEXT(i) = LAT_BASE + LAT_NEXT(i) * LAT_NODE;
+	flush_dcache_range(LAT_BASE, LAT_BASE + (u64)n * LAT_NODE);
+}
+
+static u64 lat_chase(u64 p, u32 loads)
+{
+	u32 i;
+
+	for (i = 0; i < loads; i += 8) {
+		p = *(volatile u64 *)(uintptr_t)p;
+		p = *(volatile u64 *)(uintptr_t)p;
+		p = *(volatile u64 *)(uintptr_t)p;
+		p = *(volatile u64 *)(uintptr_t)p;
+		p = *(volatile u64 *)(uintptr_t)p;
+		p = *(volatile u64 *)(uintptr_t)p;
+		p = *(volatile u64 *)(uintptr_t)p;
+		p = *(volatile u64 *)(uintptr_t)p;
+	}
+	return p;
+}
+
+static void lat_run(const char *name, u32 n, bool random)
+{
+	u64 p, t0, c0, dt, dc;
+
+	lat_build(n, random);
+	p = lat_chase(LAT_BASE, n < LAT_LOADS ? n : LAT_LOADS);
+	t0 = readq((void __iomem *)CLINT_MTIME);
+	c0 = csr_read(CSR_CYCLE);
+	p = lat_chase(p, LAT_LOADS);
+	dc = csr_read(CSR_CYCLE) - c0;
+	dt = readq((void __iomem *)CLINT_MTIME) - t0;
+	dt = dt * 100000 / MTIME_PER_US / LAT_LOADS;
+	dc = dc * 100 / LAT_LOADS;
+	printf("K1DDRT: lat %s %u KiB: %lu.%02lu ns %lu.%02lu cycles per load, cpu %lu MHz\n",
+	       name, n * LAT_NODE >> 10, (ulong)(dt / 100), (ulong)(dt % 100),
+	       (ulong)(dc / 100), (ulong)(dc % 100), dt ? (ulong)(dc * 1000 / dt) : 0);
+}
+
+static void lat_test(void)
+{
+	lat_run("rand", (16 << 10) / LAT_NODE, true);
+	lat_run("rand", (256 << 10) / LAT_NODE, true);
+	lat_run("seq", (32 << 20) / LAT_NODE, false);
+	lat_run("rand", (32 << 20) / LAT_NODE, true);
+}
+#endif
+
+void k1_ddr_gpl_retrain_test(u32 cs_num)
+{
+	ulong size = k1_ddr_gpl_blob_end - k1_ddr_gpl_blob;
+	ddr_retrain_func_t retrain;
+	u64 probe[MAX_PROBES];
+	u32 seed = 0x5eed0000;
+	int n, round, rc;
+
+	printf("K1DDRT: open firmware %lu bytes, cs_num %u\n", size, cs_num);
+	printf("K1DDRT: pll1 0x%08x 0x%08x pll2 0x%08x clksel 0x%08x\n",
+	       readl((void __iomem *)(PMU_BASE + 0x39c)),
+	       readl((void __iomem *)(PMU_BASE + 0x3a0)),
+	       readl((void __iomem *)(PMU_BASE + 0x3a8)),
+	       readl((void __iomem *)(PMU_BASE + 0x3b4)));
+	if (size < GPL_HEADER_SIZE ||
+	    memcmp(k1_ddr_gpl_blob + GPL_MAGIC_OFFSET, "K1DDRGPL", 8)) {
+		printf("K1DDRT: bad open firmware image\n");
+		return;
+	}
+
+	n = build_probes(probe);
+	check_dram(probe, n, 0, seed);
+
+	memcpy((void *)DDR_FIRMWARE_BASE, k1_ddr_gpl_blob, size);
+	asm volatile ("fence.i" ::: "memory");
+	retrain = (ddr_retrain_func_t)(DDR_FIRMWARE_BASE + GPL_RETRAIN_OFFSET);
+
+	for (round = 0; round < RETRAIN_ROUNDS; round++) {
+		rc = retrain(DDR_CTRL_BASE, cs_num, puts, 0);
+		printf("K1DDRT: round %d rc %d\n", round, rc);
+		check_dram(probe, n, seed, seed + 1);
+		seed++;
+	}
+#ifdef K1_VEHICLE_LAT
+	lat_test();
+#endif
+	printf("K1DDRT-DONE\n");
+#ifdef K1_VEHICLE_RESET
+	k1_vehicle_reset();
+#endif
+}
