@@ -26,3 +26,49 @@ $(FW_TARGET): FORCE
 	fi
 
 clean-files += $(FW_TARGET)
+
+# validation only: re-train with the open DDR firmware after ddr_fw.bin
+ifneq ($(DDR_GPL_FILE),)
