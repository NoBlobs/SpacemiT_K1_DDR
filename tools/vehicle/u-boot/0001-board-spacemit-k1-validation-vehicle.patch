diff --git a/board/spacemit/k1/emmc_tool.c b/board/spacemit/k1/emmc_tool.c
new file mode 100644
index 0000000..4b1fe88
--- /dev/null
+++ b/board/spacemit/k1/emmc_tool.c
@@ -0,0 +1,352 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright (C) 2026 Thalles Campagnani
+/*
+ * Validation-vehicle eMMC monitor on the UART, run from spl_board_init():
+ * look at the boot areas, copy them to the host and clear the FSBL, so the
+ * BootROM falls back to USB download. One command per line; every answer
+ * ends with the prompt.
+ *
+ *   info                          card and EXT_CSD boot fields
+ *   scan <part> <blk> <count>     a line per 64 KiB: crc32, kind, extent
+ *   dump <part> <blk> <count>     a line per block or 64 bytes, then crc32
+ *   zero <part> <blk> <count>     write zeros and read them back
+ *   quit                          leave, SPL goes on
+ *
+ * part: 0 user area, 1 boot0, 2 boot1. In the user area only blocks
+ * 34..8191 are writable: the GPT and everything past 4 MiB stay out of reach.
+ */
+
+#include <blk.h>
+#include <mmc.h>
+#include <stdio.h>
+#include <vsprintf.h>
+#include <dm/device.h>
+#include <linux/ctype.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <u-boot/crc.h>
+#include "emmc_tool.h"
+
+#define EMMC_NAME	"mmc@d4281000"
+#define PROMPT		"K1EMMC> "
+#define BLK_SIZE	512
+#define CHUNK_BLKS	128
+#define LINE_BYTES	64
+#define USER_WR_FIRST	34
+#define USER_WR_END	8192
+#define MAX_ARGS	4
+
+/* DDR scratch, clear of the SPL stack, malloc and FIT load area */
+#define RD_BUF		((u8 *)0x20000000UL)
+#define ZERO_BUF	((u8 *)0x20100000UL)
+
+enum fill { FILL_ZERO, FILL_FF, FILL_DATA };
+
+/* first/last: offsets of the first and last non-zero byte */
+static enum fill fill_of(const u8 *p, ulong len, ulong *first, ulong *last)
+{
+	bool ff = true;
+	ulong i;
+
+	*first = len;
+	*last = 0;
+	for (i = 0; i < len; i++) {
+		if (p[i] != 0xff)
+			ff = false;
+		if (p[i]) {
+			if (*first == len)
+				*first = i;
+			*last = i;
+		}
+	}
+	if (*first == len) {
+		*first = 0;
+		return FILL_ZERO;
+	}
+	return ff ? FILL_FF : FILL_DATA;
+}
+
+static const char *fill_name(enum fill f)
+{
+	return f == FILL_ZERO ? "zero" : f == FILL_FF ? "ff" : "data";
+}
+
+static void put_hex(const u8 *p, ulong len)
+{
+	static const char digits[] = "0123456789abcdef";
+	char line[2 * LINE_BYTES + 1];
+	ulong i;
+
+	for (i = 0; i < len; i++) {
+		line[2 * i] = digits[p[i] >> 4];
+		line[2 * i + 1] = digits[p[i] & 15];
+	}
+	line[2 * len] = '\0';
+	puts(line);
+}
+
+static struct mmc *emmc_open(void)
+{
+	struct mmc *mmc;
+	int ret;
+
+	ret = mmc_init_device(0);
+	if (ret) {
+		printf("E mmc0 probe %d\n", ret);
+		return NULL;
+	}
+	mmc = find_mmc_device(0);
+	if (!mmc) {
+		printf("E mmc0 missing\n");
+		return NULL;
+	}
+	if (strcmp(mmc->dev->name, EMMC_NAME)) {
+		printf("E mmc0 is %s, not " EMMC_NAME "\n", mmc->dev->name);
+		return NULL;
+	}
+	ret = mmc_init(mmc);
+	if (ret) {
+		printf("E mmc_init %d\n", ret);
+		return NULL;
+	}
+	if (IS_SD(mmc) || !mmc->ext_csd) {
+		printf("E %s is not an eMMC\n", mmc->dev->name);
+		return NULL;
+	}
+	return mmc;
+}
+
+static struct blk_desc *emmc_part(struct mmc *mmc, ulong part, ulong blk,
+				  ulong count)
+{
+	struct blk_desc *desc = mmc_get_blk_desc(mmc);
+	int ret;
+
+	if (part > 2) {
+		printf("E part %lu: 0 user, 1 boot0, 2 boot1\n", part);
+		return NULL;
+	}
+	ret = blk_dselect_hwpart(desc, part);
+	if (ret) {
+		printf("E select part %lu: %d\n", part, ret);
+		return NULL;
+	}
+	if (!count || blk >= desc->lba || count > desc->lba - blk) {
+		printf("E range 0x%lx+0x%lx past 0x%lx blocks\n", blk, count,
+		       (ulong)desc->lba);
+		return NULL;
+	}
+	return desc;
+}
+
+static bool read_blocks(struct blk_desc *desc, ulong blk, ulong n, u8 *buf)
+{
+	ulong got = blk_dread(desc, blk, n, buf);
+
+	if (got != n) {
+		printf("E read 0x%lx+0x%lx: got 0x%lx\n", blk, n, got);
+		return false;
+	}
+	return true;
+}
+
+static void cmd_info(struct mmc *mmc)
+{
+	const u8 *x = mmc->ext_csd;
+
+	/* the SPL printf has no %llx; ulong is 64 bits here */
+	printf("I name %s rev %u user_blocks 0x%lx boot_bytes 0x%lx\n",
+	       mmc->dev->name, x[EXT_CSD_REV],
+	       (ulong)(mmc->capacity_user / BLK_SIZE),
+	       (ulong)mmc->capacity_boot);
+	printf("I part_conf 0x%02x boot_enable %u access %u boot_bus 0x%02x\n",
+	       x[EXT_CSD_PART_CONF],
+	       EXT_CSD_EXTRACT_BOOT_PART(x[EXT_CSD_PART_CONF]),
+	       EXT_CSD_EXTRACT_PARTITION_ACCESS(x[EXT_CSD_PART_CONF]),
+	       x[EXT_CSD_BOOT_BUS_WIDTH]);
+	printf("I boot_wp 0x%02x boot_wp_status 0x%02x boot_mult %u rpmb_mult %u\n",
+	       x[EXT_CSD_BOOT_WP], x[EXT_CSD_BOOT_WP_STATUS],
+	       x[EXT_CSD_BOOT_MULT], x[EXT_CSD_RPMB_MULT]);
+}
+
+static void cmd_scan(struct mmc *mmc, ulong part, ulong blk, ulong count)
+{
+	struct blk_desc *desc = emmc_part(mmc, part, blk, count);
+	ulong end = blk + count, first, last, n;
+	enum fill f;
+
+	if (!desc)
+		return;
+	for (; blk < end; blk += n) {
+		n = min(end - blk, (ulong)CHUNK_BLKS);
+		if (!read_blocks(desc, blk, n, RD_BUF))
+			return;
+		f = fill_of(RD_BUF, n * BLK_SIZE, &first, &last);
+		printf("S %lu 0x%06lx 0x%03lx %08x %-4s 0x%05lx 0x%05lx ", part,
+		       blk, n, crc32(0, RD_BUF, n * BLK_SIZE), fill_name(f),
+		       first, last);
+		put_hex(RD_BUF, 16);
+		puts("\n");
+	}
+}
+
+static void cmd_dump(struct mmc *mmc, ulong part, ulong blk, ulong count)
+{
+	struct blk_desc *desc = emmc_part(mmc, part, blk, count);
+	ulong end = blk + count, start = blk, first, last, n, b, off;
+	u32 crc = 0;
+	const u8 *p;
+
+	if (!desc)
+		return;
+	for (; blk < end; blk += n) {
+		n = min(end - blk, (ulong)CHUNK_BLKS);
+		if (!read_blocks(desc, blk, n, RD_BUF))
+			return;
+		crc = crc32(crc, RD_BUF, n * BLK_SIZE);
+		for (b = 0; b < n; b++) {
+			p = RD_BUF + b * BLK_SIZE;
+			switch (fill_of(p, BLK_SIZE, &first, &last)) {
+			case FILL_ZERO:
+				printf("Z 0x%06lx\n", blk + b);
+				continue;
+			case FILL_FF:
+				printf("F 0x%06lx\n", blk + b);
+				continue;
+			case FILL_DATA:
+				break;
+			}
+			for (off = 0; off < BLK_SIZE; off += LINE_BYTES) {
+				printf("D 0x%06lx 0x%03lx ", blk + b, off);
+				put_hex(p + off, LINE_BYTES);
+				puts("\n");
+			}
+		}
+	}
+	printf("C %lu 0x%06lx 0x%06lx %08x\n", part, start, count, crc);
+}
+
+static bool zero_allowed(ulong part, ulong blk, ulong count)
+{
+	if (part != 0)
+		return true;
+	if (blk >= USER_WR_FIRST && blk < USER_WR_END &&
+	    count <= USER_WR_END - blk)
+		return true;
+	printf("E user area writes only inside 0x%x..0x%x\n", USER_WR_FIRST,
+	       USER_WR_END - 1);
+	return false;
+}
+
+static void cmd_zero(struct mmc *mmc, ulong part, ulong blk, ulong count)
+{
+	struct blk_desc *desc;
+	ulong end = blk + count, start = blk, first, last, n, wrote, bad = 0;
+
+	if (!zero_allowed(part, blk, count))
+		return;
+	desc = emmc_part(mmc, part, blk, count);
+	if (!desc)
+		return;
+	memset(ZERO_BUF, 0, CHUNK_BLKS * BLK_SIZE);
+	for (; blk < end; blk += n) {
+		n = min(end - blk, (ulong)CHUNK_BLKS);
+		wrote = blk_dwrite(desc, blk, n, ZERO_BUF);
+		if (wrote != n) {
+			printf("E write 0x%lx+0x%lx: wrote 0x%lx\n", blk, n,
+			       wrote);
+			return;
+		}
+	}
+	for (blk = start; blk < end; blk += n) {
+		n = min(end - blk, (ulong)CHUNK_BLKS);
+		if (!read_blocks(desc, blk, n, RD_BUF))
+			return;
+		if (fill_of(RD_BUF, n * BLK_SIZE, &first, &last) != FILL_ZERO)
+			bad++;
+	}
+	printf("W %lu 0x%06lx 0x%06lx %s\n", part, start, count,
+	       bad ? "VERIFY-FAILED" : "zeroed");
+}
+
+static int read_line(char *buf, int size)
+{
+	int n = 0, c;
+
+	for (;;) {
+		c = getchar();
+		if (c == '\r' || c == '\n') {
+			if (!n)
+				continue;
+			buf[n] = '\0';
+			puts("\n");
+			return n;
+		}
+		if ((c == '\b' || c == 0x7f) && n) {
+			n--;
+			puts("\b \b");
+			continue;
+		}
+		if (isprint(c) && n < size - 1) {
+			buf[n++] = c;
+			putc(c);
+		}
+	}
+}
+
+static int split(char *line, char **argv)
+{
+	int argc = 0;
+
+	while (*line && argc < MAX_ARGS) {
+		while (*line == ' ')
+			*line++ = '\0';
+		if (!*line)
+			break;
+		argv[argc++] = line;
+		while (*line && *line != ' ')
+			line++;
+	}
+	return argc;
+}
+
+void k1_emmc_tool(void)
+{
+	char line[80], *argv[MAX_ARGS];
+	ulong a[3] = { 0 };
+	struct mmc *mmc;
+	int argc, i;
+
+	puts("K1EMMC: monitor\n");
+	mmc = emmc_open();
+	if (!mmc) {
+		puts("K1EMMC: no eMMC, leaving\n");
+		return;
+	}
+	cmd_info(mmc);
+	for (;;) {
+		puts(PROMPT);
+		read_line(line, sizeof(line));
+		argc = split(line, argv);
+		if (!argc)
+			continue;
+		for (i = 1; i < argc; i++)
+			a[i - 1] = simple_strtoul(argv[i], NULL, 0);
+		if (!strcmp(argv[0], "quit"))
+			break;
+		if (!strcmp(argv[0], "info"))
+			cmd_info(mmc);
+		else if (argc != 4)
+			puts("E usage: scan|dump|zero <part> <blk> <count>\n");
+		else if (!strcmp(argv[0], "scan"))
+			cmd_scan(mmc, a[0], a[1], a[2]);
+		else if (!strcmp(argv[0], "dump"))
+			cmd_dump(mmc, a[0], a[1], a[2]);
+		else if (!strcmp(argv[0], "zero"))
+			cmd_zero(mmc, a[0], a[1], a[2]);
+		else
+			printf("E unknown command %s\n", argv[0]);
+	}
+	blk_dselect_hwpart(mmc_get_blk_desc(mmc), 0);
+	puts("K1EMMC: bye\n");
+}
